<Window
    x:Class="Bloxstrap.UI.Elements.Dialogs.SetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:Bloxstrap.Resources"
    Title="{x:Static resources:Strings.Setup_Title}"
    Width="880"
    Height="580"
    ResizeMode="NoResize"
    WindowStyle="None"
    WindowStartupLocation="CenterScreen"
    Background="#131418"
    Foreground="#EDEEF0"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    KeyDown="Window_KeyDown"
    Loaded="Window_Loaded">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#1EA7F5" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0C0E" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0F1013" />
        <SolidColorBrush x:Key="HoverBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A3A7AF" />
        <SolidColorBrush x:Key="DimBrush" Color="#6E727A" />
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <LinearGradientBrush x:Key="TileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#08ACFC" />
            <GradientStop Offset="1" Color="#4AAEA3" />
        </LinearGradientBrush>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Focus" Margin="-3" CornerRadius="9" BorderBrush="#EDEEF0" BorderThickness="2" Visibility="Collapsed" />
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EDEEF0" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Focus" Margin="-3" CornerRadius="9" BorderBrush="#EDEEF0" BorderThickness="2" Visibility="Collapsed" />
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="#EDEEF0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#EDEEF0" />
                                <Setter Property="Foreground" Value="#EDEEF0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionRow" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EDEEF0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="6" Margin="-10,4" Padding="10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="18" Height="18" Margin="0,2,14,0" VerticalAlignment="Top">
                                        <Ellipse x:Name="Ring" Stroke="{StaticResource DimBrush}" StrokeThickness="1.5" />
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource OnAccentBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <ContentPresenter Grid.Column="1" />
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#EDEEF0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchRow" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#EDEEF0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="6" Margin="-10,2" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" />
                                    <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" Margin="20,0,0,0" CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource MutedBrush}" Background="Transparent" VerticalAlignment="Center">
                                        <Ellipse x:Name="Knob" Width="10" Height="10" Margin="4,0" HorizontalAlignment="Left" Fill="{StaticResource MutedBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="Knob" Property="Width" Value="12" />
                                <Setter TargetName="Knob" Property="Height" Value="12" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#EDEEF0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EDEEF0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <Border x:Name="Frame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
                                <ContentPresenter />
                            </Border>
                            <TextBlock x:Name="Label" Margin="2,8,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="{TemplateBinding Tag}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource DimBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Frame" Property="Padding" Value="2" />
                                <Setter TargetName="Label" Property="Foreground" Value="#EDEEF0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#EDEEF0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DimBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#EDEEF0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StepSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,6,0,18" />
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="Background_MouseLeftButtonDown">
        <Grid x:Name="WelcomeView" Margin="64,0,64,0">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <Viewbox Width="88" Height="88" HorizontalAlignment="Left">
                    <Canvas Width="200" Height="200">
                        <Canvas.RenderTransform>
                            <RotateTransform Angle="10" CenterX="100" CenterY="100" />
                        </Canvas.RenderTransform>
                        <Rectangle x:Name="TileTL" Width="84" Height="84" Canvas.Left="12" Canvas.Top="12" RadiusX="12" RadiusY="12" Fill="{StaticResource TileBrush}" Opacity="0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="TileTR" Width="84" Height="84" Canvas.Left="104" Canvas.Top="12" RadiusX="12" RadiusY="12" Fill="{StaticResource TileBrush}" Opacity="0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="TileBL" Width="84" Height="84" Canvas.Left="12" Canvas.Top="104" RadiusX="12" RadiusY="12" Fill="{StaticResource TileBrush}" Opacity="0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="TileBR" Width="84" Height="84" Canvas.Left="104" Canvas.Top="104" RadiusX="12" RadiusY="12" Fill="{StaticResource TileBrush}" Opacity="0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Chip" Width="56" Height="44" Canvas.Left="72" Canvas.Top="78" RadiusX="10" RadiusY="10" Fill="#131418" Opacity="0" />
                    </Canvas>
                </Viewbox>

                <StackPanel x:Name="WelcomeText" Margin="0,32,0,0" Opacity="0">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold" Text="{x:Static resources:Strings.Setup_Welcome_Heading}" />
                    <TextBlock x:Name="WelcomeBody" Margin="0,10,0,0" MaxWidth="480" HorizontalAlignment="Left" FontSize="15" LineHeight="23" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    <StackPanel Margin="0,30,0,0" Orientation="Horizontal">
                        <Button x:Name="StartButton" IsDefault="True" Style="{StaticResource PrimaryButton}" Content="{x:Static resources:Strings.Setup_Start}" Click="StartButton_Click" />
                        <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="{x:Static resources:Strings.Setup_Skip}" Click="SkipButton_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="StepsView" Visibility="Collapsed" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid Margin="24,26,16,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Image Width="24" Height="24" Source="pack://application:,,,/reistrap.ico" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Margin="9,0,0,1" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Text="reistrap" />
                    </StackPanel>
                    <StackPanel x:Name="StepList" Grid.Row="1" Margin="0,40,0,0" />
                    <Button Grid.Row="2" HorizontalAlignment="Left" Margin="-10,0,0,0" Style="{StaticResource TextButton}" Content="{x:Static resources:Strings.Setup_Skip}" Click="SkipButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="44,40,40,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="StepCounter" Grid.Row="0" Margin="0,0,0,6" FontSize="13" Foreground="{StaticResource DimBrush}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid x:Name="StepHost" Margin="0,0,4,0">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>

                    <StackPanel x:Name="ImportStep">
                        <TextBlock Style="{StaticResource StepTitle}" Text="{x:Static resources:Strings.Setup_Import_Heading}" />
                        <TextBlock Style="{StaticResource StepSubtitle}" Text="{x:Static resources:Strings.Setup_Import_Subheading}" />
                        <StackPanel x:Name="ImportChoices" />
                    </StackPanel>

                    <StackPanel x:Name="LookStep">
                        <TextBlock Style="{StaticResource StepTitle}" Text="{x:Static resources:Strings.Setup_Look_Heading}" />
                        <TextBlock Style="{StaticResource StepSubtitle}" Text="{x:Static resources:Strings.Setup_Look_Subheading}" />
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static resources:Strings.Menu_Appearance_Global_Theme_Title}" />
                        <UniformGrid x:Name="ThemeChoices" Margin="0,10,-12,22" Columns="3" />
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static resources:Strings.Menu_Appearance_AccentTheme_Title}" />
                        <WrapPanel x:Name="AccentChoices" Margin="-5,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="FeaturesStep">
                        <TextBlock Style="{StaticResource StepTitle}" Text="{x:Static resources:Strings.Setup_Features_Heading}" />
                        <TextBlock Style="{StaticResource StepSubtitle}" Text="{x:Static resources:Strings.Setup_Features_Subheading}" />
                        <StackPanel x:Name="FeatureChoices" />
                    </StackPanel>

                    <StackPanel x:Name="PerformanceStep">
                        <TextBlock Style="{StaticResource StepTitle}" Text="{x:Static resources:Strings.Setup_Performance_Heading}" />
                        <TextBlock Style="{StaticResource StepSubtitle}" Text="{x:Static resources:Strings.Setup_Performance_Subheading}" />
                        <StackPanel x:Name="PerformanceChoices" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="{x:Static resources:Strings.Setup_Back}" Click="BackButton_Click" />
                    <Button x:Name="NextButton" IsDefault="True" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{x:Static resources:Strings.Setup_Next}" Click="NextButton_Click" />
                </Grid>
            </Grid>
        </Grid>

        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Width="36" Height="32" Padding="0" Style="{StaticResource TextButton}" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" ToolTip="{x:Static resources:Strings.Common_Close}" Click="SkipButton_Click" />
    </Grid>
</Window>
